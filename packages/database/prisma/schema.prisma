datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SYSTEM_ADMIN
  MERCHANT_ADMIN
  CUSTOMER
  DRIVER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  CANCELLED
}

enum DeliveryStatus {
  SEARCHING
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String
  userRole      UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  // Relations
  tenantMemberships TenantMember[]
  driverProfile     DriverProfile? // 1:1 relationship
  orders            Order[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  family    String
  expiresAt DateTime
  isRevoked Boolean @default(false)
  createdAt DateTime @default(now())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
}

model TenantMember {
  id       Int      @id @default(autoincrement())
  userId   Int
  tenantId Int
  role     UserRole // The role of the user SPECIFICALLY for this tenant

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId]) // A user can only be a member of a tenant once
}

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members     TenantMember[]
  restaurants Restaurant[]
  orders      Order[] // Explicit relation for fast tenant-scoped queries
}

model Restaurant {
  id          Int       @id @default(autoincrement())
  tenantId    Int // Explicit Tenant Isolation Key
  name        String
  location    String
  description String
  isOpen      Boolean   @default(true) // Operational state
  deletedAt   DateTime? // Soft delete

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  menuItems MenuItem[]
  orders    Order[]

  @@index([tenantId]) // Fast lookup for "Get all restaurants for Tenant X"
}

model MenuItem {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  tenantId     Int // Explicit Tenant Isolation Key
  name         String
  price        Decimal   @db.Decimal(10, 2) // Always use Decimal for currency
  isAvailable  Boolean   @default(true)
  deletedAt    DateTime?

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([tenantId])
  @@index([restaurantId])
}

model Order {
  id           Int         @id @default(autoincrement())
  tenantId     Int // Explicit Tenant Isolation Key
  customerId   Int
  restaurantId Int
  total        Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDING)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer   User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  delivery   Delivery? // 1:1 with Delivery

  @@index([tenantId])
  @@index([customerId])
  @@index([restaurantId])
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  menuItemId   Int
  snapshotName String // Preserves name if MenuItem is renamed later
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
}

model DriverProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique // 1:1 with User
  isOnline    Boolean  @default(false) // Real-time availability state
  currentLat  Float
  currentLong Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[] // A driver has a history of many deliveries
}

model Delivery {
  id              Int            @id @default(autoincrement())
  orderId         Int            @unique // 1:1 with Order
  driverProfileId Int? // NULLABLE: No driver when status is SEARCHING
  status          DeliveryStatus @default(SEARCHING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  driver DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)

  @@index([orderId])
}
