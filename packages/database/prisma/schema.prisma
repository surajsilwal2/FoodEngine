datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SYSTEM_ADMIN
  MERCHANT_ADMIN
  CUSTOMER
  DRIVER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MOCK_CARD
  CASH_ON_DELIVERY
  MOCK_WALLET
}

enum DeliveryStatus {
  SEARCHING
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  passwordHash  String
  userRole      UserRole       @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  // Relations
  tenantMemberships TenantMember[]
  driverProfile     DriverProfile? // 1:1 relationship
  orders            Order[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  family    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int
}

model TenantMember {
  id        Int      @id @default(autoincrement())
  userId    Int
  tenantId  Int
  role      UserRole // The role of the user SPECIFICALLY for this tenant
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId]) // A user can only be a member of a tenant once
}

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members     TenantMember[]
  restaurants Restaurant[]
  orders      Order[] // Explicit relation for fast tenant-scoped queries
  payments    Payment[]
}

model Restaurant {
  id          Int       @id @default(autoincrement())
  tenantId    Int // Explicit Tenant Isolation Key
  name        String
  location    String
  description String
  isOpen      Boolean   @default(true) // Operational state
  deletedAt   DateTime? // Soft delete
  createdAt   DateTime  @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  categories MenuCategory[]
  menuItems  MenuItem[]
  orders     Order[]

  @@index([tenantId]) // Fast lookup for "Get all restaurants for Tenant X"
}

model MenuItem {
  id           Int       @id @default(autoincrement())
  restaurantId Int
  tenantId     Int // Explicit Tenant Isolation Key
  name         String
  price        Decimal   @db.Decimal(10, 2) // Always use Decimal for currency
  description  String?
  isAvailable  Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant     Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  menuCategory   MenuCategory? @relation(fields: [menuCategoryId], references: [id], onDelete: SetNull)
  menuCategoryId Int?

  @@index([tenantId])
  @@index([restaurantId])
  @@index([menuCategoryId])
}

model MenuCategory {
  id           Int         @id @default(autoincrement())
  tenantId     Int // explicit tenant isloation key
  name         String
  displayOrder Int         @default(0)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  menuItems    MenuItem[]
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  restaurantId Int?

  @@index([tenantId])
  @@index([restaurantId])
}

model Order {
  id           Int         @id @default(autoincrement())
  tenantId     Int // Explicit Tenant Isolation Key
  customerId   Int
  restaurantId Int
  total        Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDING)
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer   User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  delivery   Delivery? // 1:1 with Delivery
  payment    Payment?

  @@index([tenantId])
  @@index([customerId])
  @@index([restaurantId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  tenant        Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantId      Int
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  provider      PaymentMethod @default(MOCK_CARD)
  transactionId String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  orders  Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId Int   @unique

  @@index([tenantId])
  @@index([orderId])
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  menuItemId   Int
  snapshotName String // Preserves name if MenuItem is renamed later
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
}

model DriverProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique // 1:1 with User
  licenseNumber  String
  vehicleDetails String
  isApproved     Boolean
  isOnline       Boolean  @default(false) // Real-time availability state
  currentLat     Float?
  currentLong    Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[] // A driver has a history of many deliveries
}

model Delivery {
  id              Int            @id @default(autoincrement())
  orderId         Int            @unique // 1:1 with Order
  driverProfileId Int? // NULLABLE: No driver when status is SEARCHING
  status          DeliveryStatus @default(SEARCHING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  driver DriverProfile? @relation(fields: [driverProfileId], references: [id], onDelete: Restrict)

  @@index([orderId])
}
