datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SYSTEM_ADMIN
  MERCHANT_ADMIN
  CUSTOMER
  DRIVER
}

enum OrderStatus {
  CREATED
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tenantMemberships TenantMember[]
  orders            Order[]
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique // Used for custom subdomain resolution (e.g. burgerking.foodengine.com)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tenant-isolated entities
  members   TenantMember[]
  menuItems MenuItem[]
  orders    Order[]
}

model TenantMember {
  id       String @id @default(uuid())
  userId   String
  tenantId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
}

model MenuItem {
  id          String   @id @default(uuid())
  tenantId    String // Explicit Tenant Isolation Key
  name        String
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([tenantId]) // Fast indexed lookup by tenant
}

model Order {
  id          String      @id @default(uuid())
  tenantId    String // Explicit Tenant Isolation Key
  customerId  String
  status      OrderStatus @default(CREATED)
  totalAmount Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    OrderItem[]

  @@index([tenantId])
  @@index([customerId])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
}
